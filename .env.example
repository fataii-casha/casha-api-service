NODE_ENV=development
PORT=4000

# Use a replica-set-enabled MongoDB (Atlas, or a local rs) — multi-document
# transactions in the QR payment flow require it.
MONGO_URI=mongodb://127.0.0.1:27017/casha

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

CLIENT_URL=*

QR_DYNAMIC_TTL_SECONDS=300

LOG_LEVEL=info
