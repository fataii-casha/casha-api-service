NODE_ENV=development
PORT=4000

# Use a replica-set-enabled MongoDB (Atlas, or a local rs) — multi-document
# transactions in the QR payment flow require it.
MONGO_URI=mongodb://127.0.0.1:27017/casha

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

CLIENT_URL=*

QR_DYNAMIC_TTL_SECONDS=300

LOG_LEVEL=info

# The public URL of THIS deployment (what Swagger UI defaults to). Leave unset locally.
API_URL=

# Optional: lets one deployed docs page also list other environments in the server dropdown.
STAGING_API_URL=https://casha-staging.example.com/api/v1
PRODUCTION_API_URL=https://api.casha.ng/api/v1
# Every OTP is this fixed 6-digit value instead of a random one, so testers can log in.
# Defaults to 000000 when NODE_ENV=development; leave empty to disable. Refused in production.
# FIXED_OTP=000000

# Stellas (bank accounts + transfers). Sandbox by default; set the live URL in production.
STELLAS_BASE_URL=https://sandbox.stellasbank.com/api/v1
STELLAS_API_KEY=
STELLAS_API_SECRET=
STELLAS_BUSINESS_ID=
# Bank details shown for Stellas virtual accounts. Confirm the bank code with Stellas.
STELLAS_BANK_NAME=Stellas Microfinance Bank
STELLAS_BANK_CODE=

# Encrypts stored BVNs. Required — the server won't start without it. Use a different key per
# environment and never change it once data exists (stored BVNs become unreadable).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
